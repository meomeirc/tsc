<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release;Publish</Configurations>
    <!-- DesktopGL remains the default. DesktopVK and WindowsDX12 use MonoGame's native backend. -->
    <TSCBackend Condition="'$(TSCBackend)' == ''">DesktopGL</TSCBackend>
    <MonoGamePlatform>$(TSCBackend)</MonoGamePlatform>
    <!-- MonoGame's content task composes its restore and MGCB commands from this property.
         Some SDK/IDE launch paths leave it unset, so default to the dotnet executable on PATH
         while still allowing callers to override it with -p:DotnetCommand=... . -->
    <DotnetCommand Condition="'$(DotnetCommand)' == ''">dotnet</DotnetCommand>
    <DefineConstants Condition="'$(TSCBackend)' == 'WindowsDX12'">$(DefineConstants);TSC_WINDOWS_DX12;TSC_NATIVE_BACKEND;TSC_SM6_BACKEND</DefineConstants>
    <DefineConstants Condition="'$(TSCBackend)' == 'DesktopVK'">$(DefineConstants);TSC_DESKTOP_VK;TSC_NATIVE_BACKEND;TSC_SM6_BACKEND</DefineConstants>
    <!-- Keep MGCB discovery explicit so the Android-only Content.Android.mgcb is not
         auto-added with the same Content/ target paths. -->
    <EnableMGCBItems>false</EnableMGCBItems>
    <!-- Restore the local MGCB tool from this project's explicit manifest below. The
         package task's automatic restore hides the underlying Exec error, and its
         `dotnet mgcb` shorthand is less reliable than `dotnet tool run mgcb`. -->
    <AutoRestoreMGCBTool>false</AutoRestoreMGCBTool>
    <_Command Condition="'$(_Command)' == ''">&quot;$(DotnetCommand)&quot; tool run mgcb --</_Command>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>
  <Target Name="RestoreTscMgcbLocalTool"
          BeforeTargets="CollectPackageReferences"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="$(MSBuildProjectFullPath);$(MSBuildProjectDirectory)\.config\dotnet-tools.json"
          Outputs="$(IntermediateOutputPath)mgcb.tool.restore">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\.config\dotnet-tools.json')"
           Text="The local MGCB tool manifest is missing: $(MSBuildProjectDirectory)\.config\dotnet-tools.json" />
    <MakeDir Directories="$(IntermediateOutputPath)" Condition="!Exists('$(IntermediateOutputPath)')" />
    <Exec Command="&quot;$(DotnetCommand)&quot; tool restore --tool-manifest &quot;$(MSBuildProjectDirectory)\.config\dotnet-tools.json&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Touch Files="$(IntermediateOutputPath)mgcb.tool.restore" AlwaysCreate="true" />
  </Target>

  <Target Name="ValidateTscBackend" BeforeTargets="Prepare;PrepareForBuild">
    <Error Condition="'$(TSCBackend)' != 'DesktopGL' and '$(TSCBackend)' != 'DesktopVK' and '$(TSCBackend)' != 'WindowsDX12'"
           Text="Unsupported TSCBackend '$(TSCBackend)'. Supported values are DesktopGL, DesktopVK, and WindowsDX12." />
  </Target>

  <PropertyGroup Condition="'$(Configuration)' == 'Publish'">
    <!-- Publish is a separate feature-reduced build; Debug and Release remain full-featured. -->
    <DefineConstants>$(DefineConstants);TSC_PUBLISH</DefineConstants>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Publish'">
    <Compile Remove="Skins\SkinDebugConsole.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Rendering\FrameLoopDiagnostics.cs" />
    <Compile Remove="Rendering\Playfield.ChartDrawPacingDiagnostics.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="Moonsharp" Version="2.0.0" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.6.1" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
  </ItemGroup>
  <ItemGroup Condition="'$(TSCBackend)' == 'DesktopGL'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.6.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TSCBackend)' == 'DesktopVK'">
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.6.1" />
    <!-- DesktopVK uses the native MonoGame host with the Windows Vulkan runtime. -->
    <PackageReference Include="MonoGame.Runtime.Windows.Vulkan" Version="3.8.6.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TSCBackend)' == 'WindowsDX12'">
    <PackageReference Include="MonoGame.Framework.Native" Version="3.8.6.1" />
    <!-- Keep the native DX12 runtime aligned with MonoGame.Framework.Native to avoid native ABI mismatches. -->
    <PackageReference Include="MonoGame.Runtime.Windows.DX12" Version="3.8.6.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- The updater UI and update engine are part of TSC.exe now. Exclude only stale
         nested build artifacts left by older versions of the separate updater project. -->
    <Compile Remove="obj\**\*.cs;bin\**\*.cs;Updater\obj\**\*.cs;Updater\bin\**\*.cs;Launcher\**\*.cs;Android\**\*.cs" />
    <!-- State contains generated song-list/cache data and updater bookkeeping, not project assets.
         Never allow a developer's State files to flow into build or publish outputs. -->
    <Compile Remove="State\**\*.cs" />
    <None Remove="State\**\*" />
    <Content Remove="State\**\*" />
    <EmbeddedResource Remove="State\**\*" />
    <None Update="Updater\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="build\PackageFiles\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <MonoGameContentReference Include="Content\Content.mgcb" />
    <EmbeddedResource Include="info.md" LogicalName="TSC.info.md" />
    <EmbeddedResource Include="version.txt" LogicalName="TSC.version.txt" />
    <None Update="info.md" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Update="version.txt" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <!-- Tool payloads are staged beside the root launcher after publish. Never publish a
         locally downloaded FFmpeg executable; users can install that one themselves. -->
    <None Update="tools\**\*" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <!-- Final install layout: backend-specific framework-dependent game hosts live in
       data/DesktopGL, data/DesktopVK, and data/WindowsDX12. One shared .NET 8 runtime,
       the Native AOT launcher, user files, Default skin, and tools stay at the install root. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Publish'">
    <TSCInstallRoot Condition="'$(TSCInstallRoot)' == ''">$(MSBuildProjectDirectory)\bin\Publish\win-x64\</TSCInstallRoot>
    <TSCLauncherStage>$(MSBuildProjectDirectory)\obj\tsc-launcher-publish</TSCLauncherStage>
  </PropertyGroup>

  <Target Name="FinalizeTscPublishLayout" AfterTargets="Publish"
          Condition="'$(Configuration)' == 'Publish' and '$(PublishDir)' != ''">
    <MakeDir Directories="$(TSCInstallRoot)" />

    <!-- Runtime/user state belongs beside the launcher, never inside data/. Remove stale
         generated State/Logs folders from older publishes; root user data is preserved. -->
    <RemoveDir Directories="$(PublishDir)State;$(PublishDir)Logs" />

    <!-- App-owned package files are kept outside user-data folders in source control.
         Stage the build/PackageFiles tree at the install root; this lets application
         files target songs/, save/, or other user-data folders without Git ignore
         exceptions or updater path whitelists. -->
    <ItemGroup>
      <_TscPackageFiles Include="$(MSBuildProjectDirectory)\build\PackageFiles\**\*" />
    </ItemGroup>
    <MakeDir Directories="@(_TscPackageFiles->'$(TSCInstallRoot)%(RecursiveDir)')"
             Condition="'@(_TscPackageFiles)' != ''" />
    <Copy SourceFiles="@(_TscPackageFiles)"
          DestinationFiles="@(_TscPackageFiles->'$(TSCInstallRoot)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_TscPackageFiles)' != ''" />
    <!-- LAN testing is implemented in TSC now; remove helper scripts left by older publishes. -->
    <RemoveDir Directories="$(TSCInstallRoot)data\LanEditorServer;$(PublishDir)LanEditorServer" />
    <!-- Never ship a second copy of the skin under data/. -->
    <RemoveDir Directories="$(PublishDir)Skins\Default;$(PublishDir)Skins;$(PublishDir)updater;$(PublishDir)updater.next;$(PublishDir)updater.old;$(TSCInstallRoot)updater;$(TSCInstallRoot)updater.next;$(TSCInstallRoot)updater.old" />

    <!-- Include project tools beside the launcher, preserving nested folders but
         excluding FFmpeg and the legacy Python LAN helper sources. The in-process LAN
         test service is compiled into TSC and has no Python/runtime-script payload. -->
    <ItemGroup>
      <_TscRootToolFiles Include="$(MSBuildProjectDirectory)\tools\**\*"
                         Exclude="$(MSBuildProjectDirectory)\tools\**\ffmpeg.exe;$(MSBuildProjectDirectory)\tools\LanEditorServer\**\*" />
      <_TscPublishedToolFiles Include="$(PublishDir)tools\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(TSCInstallRoot)tools" />
    <MakeDir Directories="@(_TscRootToolFiles->'$(TSCInstallRoot)tools\%(RecursiveDir)')"
             Condition="'@(_TscRootToolFiles)' != ''" />
    <Copy SourceFiles="@(_TscRootToolFiles)"
          DestinationFiles="@(_TscRootToolFiles->'$(TSCInstallRoot)tools\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_TscRootToolFiles)' != ''" />
    <Delete Files="@(_TscPublishedToolFiles)" />
    <RemoveDir Directories="$(PublishDir)tools" />

    <!-- Refresh only the shipped Default skin folder; custom skins stay separate. -->
    <RemoveDir Directories="$(TSCInstallRoot)Skins\Default" />
    <MakeDir Directories="$(TSCInstallRoot)Skins\Default" />
    <ItemGroup>
      <_TscDefaultSkinFiles Include="$(MSBuildProjectDirectory)\Skins\Default\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_TscDefaultSkinFiles)"
          DestinationFiles="@(_TscDefaultSkinFiles->'$(TSCInstallRoot)Skins\Default\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <!-- Publish a self-contained Native AOT launcher. It needs no .NET runtime and has no sidecar files. -->
    <RemoveDir Directories="$(TSCLauncherStage)" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\Launcher\TSC.Launcher.csproj&quot; --configuration Release --runtime win-x64 --self-contained true -p:PublishAot=true -p:OptimizationPreference=Size -o &quot;$(TSCLauncherStage)&quot;" />
    <Error Condition="!Exists('$(TSCLauncherStage)\TSC.exe')" Text="Native AOT launcher publish failed: $(TSCLauncherStage)\TSC.exe was not created." />
    <Copy SourceFiles="$(TSCLauncherStage)\TSC.exe" DestinationFiles="$(TSCInstallRoot)TSC.exe" />
    <RemoveDir Directories="$(TSCLauncherStage)" />

    <!-- Remove stale game-side files left at root by older publish layouts. Preserve user folders/files. -->
    <ItemGroup>
      <_TscLegacyRootSidecars Include="$(TSCInstallRoot)*.dll;$(TSCInstallRoot)*.pdb;$(TSCInstallRoot)*.deps.json;$(TSCInstallRoot)*.runtimeconfig.json;$(TSCInstallRoot)createdump.exe" />
    </ItemGroup>
    <Delete Files="@(_TscLegacyRootSidecars);$(TSCInstallRoot)TSC.Updater.exe;$(TSCInstallRoot)DefaultFont.spritefont" />
    <RemoveDir Directories="$(TSCInstallRoot)runtimes;$(TSCInstallRoot)Content;$(TSCInstallRoot)Samples;$(TSCInstallRoot)textures" />
  </Target>

  <!-- Bundle a reproducible, checksum-verified copy of Google's Windows Platform-Tools
       in the install-root tools/adb folder. The archive is cached under obj/, not checked in. -->
  <Target Name="BundleTscAdbForPublish" AfterTargets="FinalizeTscPublishLayout"
          Condition="'$(Configuration)' == 'Publish' and '$(PublishDir)' != ''">
    <PropertyGroup>
      <TSCAdbArchivePath>$(MSBuildProjectDirectory)\obj\android-platform-tools\platform-tools_r37.0.1-win.zip</TSCAdbArchivePath>
      <TSCAdbDestination>$(TSCInstallRoot)tools\adb</TSCAdbDestination>
    </PropertyGroup>
    <Exec Command="powershell.exe -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\build\Prepare-Adb.ps1&quot; -ArchivePath &quot;$(TSCAdbArchivePath)&quot; -DestinationPath &quot;$(TSCAdbDestination)&quot;" />
    <Error Condition="!Exists('$(TSCAdbDestination)\adb.exe')" Text="Android Debug Bridge was not bundled. Check the Platform-Tools download and checksum in build/Prepare-Adb.ps1." />
  </Target>

  <Target Name="VerifyDefaultSkinBuildOutput" AfterTargets="Build"
          Condition="'$(Configuration)' != 'Publish'">
    <Error Condition="!Exists('$(OutDir)Skins\Default\scripts\skin.lua')"
           Text="The Default skin entry point was not copied to the build output. Expected: $(OutDir)Skins\Default\scripts\skin.lua. Check the Skins\Default content items in TSC.csproj." />
  </Target>

  <Target Name="RemoveLegacyLanEditorHelperOutput" AfterTargets="Build"
          Condition="'$(Configuration)' != 'Publish'">
    <RemoveDir Directories="$(OutDir)LanEditorServer" />
  </Target>
  <ItemGroup>
    <!-- Song bundles are runtime data, not C# source. -->
    <Compile Remove="songs\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Developer builds run from either the project root or bin/. Keep the full Default skin
         beside the executable so launches from bin/ can resolve scripts/skin.lua and its modules. -->
    <None Update="Skins\Default\**\*" Condition="'$(Configuration)' != 'Publish'" CopyToOutputDirectory="PreserveNewest" />
    <!-- Preserve compatibility for old developer-only root-level Lua files. -->
    <None Update="*.lua" Condition="'$(Configuration)' != 'Publish'" CopyToOutputDirectory="PreserveNewest" />
    <None Update="*.lua" Condition="'$(Configuration)' == 'Publish'" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <!-- Publish the shipped Default skin tree. Use the directory's actual casing,
         remove the SDK's default None items, and re-add the files as publishable Content. -->
    <None Remove="Skins\Default\**\*" Condition="'$(Configuration)' == 'Publish'" />
    <Content Include="Skins\Default\**\*" Condition="'$(Configuration)' == 'Publish'">
      <Link>Skins\Default\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>Skins\Default\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <None Include="textures\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


</Project>
